<Application x:Class="ShinroKensakuDesktop.App" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ShinroKensakuDesktop.Models"
             xmlns:controls="clr-namespace:ShinroKensakuDesktop.Views.Controls"
             xmlns:converters="clr-namespace:ShinroKensakuDesktop.Views.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Meaning colours (light values; ThemeColors replaces them on a theme change).
                 進学 = blue + graduation cap, 就職 = orange + briefcase, everywhere in the app. -->
            <SolidColorBrush x:Key="StudyBrush" Color="#2A78D6" />
            <SolidColorBrush x:Key="WorkBrush" Color="#EB6834" />
            <SolidColorBrush x:Key="NeutralBarBrush" Color="#8A8A8A" />

            <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:TextToVisibilityConverter x:Key="TextVisibility" />
            <converters:RatioToStarConverter x:Key="RatioToStar" />
            <converters:RatioToLengthConverter x:Key="RatioToLength" />
            <converters:BoolToSeverityConverter x:Key="BoolToSeverity" />

            <!-- Spacing steps: 4 / 8 / 12 / 16 / 24 / 32 (Fluent 4px grid). Field labels sit 8px above their control,
                 cards and sections are 16px apart, pages are padded 32px at the sides. -->
            <Thickness x:Key="PagePadding">32,24,32,32</Thickness>
            <Thickness x:Key="FieldLabelGap">0,0,0,8</Thickness>

            <Style x:Key="IconActionButton" TargetType="ui:Button"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
            </Style>
            <Style x:Key="PageHeader" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="LastChildFill" Value="True" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style x:Key="SectionCard" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
                <Setter Property="Padding" Value="24,20" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
            <Style x:Key="StatCard" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <!-- A small rounded label: the accent pill marks the current year. -->
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,1,8,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="TextElement.FontSize" Value="12" />
            </Style>
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="{StaticResource FieldLabelGap}" />
            </Style>
            <Style x:Key="GroupHeading" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="BodyStrong" />
                <Setter Property="Margin" Value="0,8,0,8" />
            </Style>
            <Style x:Key="YearSelector" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- A choice that shows its selected state (WPF UI has no segmented control). -->
            <Style x:Key="SegmentButton" TargetType="RadioButton"
                   BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <!-- A bar that is itself the click target, with the standard focus outline. -->
            <Style x:Key="BarButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Skeleton" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            </Style>

            <!-- Notices: error / warning / success / information, each with its own icon and colour plus text. -->
            <Style TargetType="controls:NoticeBar">
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:NoticeBar">
                            <Border x:Name="Root" CornerRadius="4" BorderThickness="1" Padding="16,12"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon x:Name="Icon" Symbol="Info24" Filled="True" FontSize="20"
                                                   VerticalAlignment="Top" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="MessageText" Text="{TemplateBinding Message}"
                                                   TextWrapping="Wrap" LineHeight="21" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Message" Value="">
                                    <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Message" Value="{x:Null}">
                                    <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Success">
                                    <Setter TargetName="Icon" Property="Symbol" Value="CheckmarkCircle24" />
                                    <Setter TargetName="Icon" Property="Foreground"
                                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Warning">
                                    <Setter TargetName="Icon" Property="Symbol" Value="Warning24" />
                                    <Setter TargetName="Icon" Property="Foreground"
                                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Error">
                                    <Setter TargetName="Icon" Property="Symbol" Value="ErrorCircle24" />
                                    <Setter TargetName="Icon" Property="Foreground"
                                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- KPI tile: kind icon and label, the value with its unit, then the change against a reference. -->
            <DataTemplate DataType="{x:Type models:StatItem}">
                <ui:Card Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="{Binding Share}" DockPanel.Dock="Right" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding Share, Converter={StaticResource TextVisibility}}" />
                            <ui:SymbolIcon x:Name="KindIcon" Symbol="DocumentBulletList24" FontSize="20"
                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                        <StackPanel x:Name="ValueRow" Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Before}" FontSize="20" VerticalAlignment="Bottom"
                                       Margin="0,0,8,3" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding Before, Converter={StaticResource TextVisibility}}" />
                            <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock x:Name="Unit" Text="件" VerticalAlignment="Bottom" Margin="4,0,0,5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="ChangeRow" Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0"
                                    TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ui:SymbolIcon x:Name="Arrow" Symbol="CaretUp16" Filled="True" FontSize="14"
                                           Margin="0,0,2,0" Visibility="Collapsed" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Change}" FontWeight="SemiBold"
                                       Visibility="{Binding Change, Converter={StaticResource TextVisibility}}" />
                            <TextBlock Text="{Binding ChangeNote}" Margin="8,0,0,0"
                                       Visibility="{Binding ChangeNote, Converter={StaticResource TextVisibility}}" />
                        </StackPanel>
                        <TextBlock x:Name="NoteRow" Grid.Row="3" Text="{Binding Note}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding Note, Converter={StaticResource TextVisibility}}" />
                        <StackPanel x:Name="Placeholder" Grid.Row="1" Grid.RowSpan="2" Margin="0,12,0,4"
                                    Visibility="Collapsed">
                            <Border Style="{StaticResource Skeleton}" Width="96" Height="26" />
                            <Border Style="{StaticResource Skeleton}" Width="140" Height="12" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </ui:Card>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatKind.Study}">
                        <Setter TargetName="KindIcon" Property="Symbol" Value="HatGraduation24" />
                        <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource StudyBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatKind.Work}">
                        <Setter TargetName="KindIcon" Property="Symbol" Value="Briefcase24" />
                        <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource WorkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:ChangeDirection.Up}">
                        <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:ChangeDirection.Down}">
                        <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Arrow" Property="Symbol" Value="CaretDown16" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Value}" Value="—">
                        <Setter TargetName="Unit" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter TargetName="ValueRow" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="ChangeRow" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="NoteRow" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- KPI row: equal columns, so the row lines up with the cards below it. -->
            <ItemsPanelTemplate x:Key="StatRow">
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
            <Style x:Key="StatList" TargetType="ItemsControl">
                <Setter Property="ItemsPanel" Value="{StaticResource StatRow}" />
                <Setter Property="Margin" Value="0,0,-16,16" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <!-- One method row: name, a bar in the kind colour, the count and its share of the whole. -->
            <DataTemplate DataType="{x:Type models:BreakdownRow}">
                <Grid Margin="28,0,0,0" MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" /><ColumnDefinition />
                        <ColumnDefinition Width="64" /><ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Label}" Margin="0,0,12,0" />
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource RatioToStar}}" />
                            <ColumnDefinition
                                Width="{Binding Ratio, Converter={StaticResource RatioToStar}, ConverterParameter=Rest}" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Bar" Height="10" CornerRadius="2" MinWidth="2"
                                Background="{DynamicResource NeutralBarBrush}" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Share}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatKind.Study}">
                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource StudyBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatKind.Work}">
                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource WorkBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Methods grouped under their kind, so 就職 is not read as one more 進学 method. -->
            <DataTemplate DataType="{x:Type models:BreakdownGroup}">
                <StackPanel Margin="0,0,0,12">
                    <DockPanel Margin="0,0,0,4" MinHeight="28">
                        <TextBlock Text="{Binding Total}" DockPanel.Dock="Right" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,64,0" />
                        <ui:SymbolIcon x:Name="KindIcon" Symbol="HatGraduation24" FontSize="20" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource StudyBrush}" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatKind.Work}">
                        <Setter TargetName="KindIcon" Property="Symbol" Value="Briefcase24" />
                        <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource WorkBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
