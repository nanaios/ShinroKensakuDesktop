<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
		xmlns:local="clr-namespace:ShinroKensakuDesktop.Windows.MainWindow"
		x:Class="ShinroKensakuDesktop.Windows.MainWindow.MainWindow" Width="1440" Height="1080">
	<ui:FluentWindow.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Windows/MainWindow/Style.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</ui:FluentWindow.Resources>
	<ui:FluentWindow.DataContext>
		<local:ViewModel />
	</ui:FluentWindow.DataContext>
	<Grid x:Name="Root">
		<ui:TitleBar x:Name="WindowTitle" Title="{Binding Title}" />
		<ui:NavigationView x:Name="MainView">
			<ui:NavigationView.MenuItems>
				<ui:NavigationViewItem Style="{StaticResource TopPageItem}">ホーム</ui:NavigationViewItem>
				<ui:NavigationViewItem Style="{StaticResource SearchPageItem}">詳細検索</ui:NavigationViewItem>
				<ui:NavigationViewItem Style="{StaticResource InfoPageItem}">情報</ui:NavigationViewItem>
			</ui:NavigationView.MenuItems>
		</ui:NavigationView>
	</Grid>
</ui:FluentWindow>