<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
	<Style TargetType="ui:NavigationView" BasedOn="{StaticResource {x:Type ui:NavigationView}}">
		<Setter Property="IsBackButtonVisible" Value="Visible" />
		<Setter Property="IsFooterSeparatorVisible" Value="False" />
		<Setter Property="IsPaneToggleVisible" Value="True" />
		<Setter Property="IsTopSeparatorVisible" Value="False" />
		<Setter Property="FrameMargin" Value="0,48,0,0" />
		<Setter Property="OpenPaneLength" Value="200" />
		<Setter Property="PaneDisplayMode" Value="Left" />
		<Setter Property="IsPaneOpen" Value="False" />
	</Style>
	<Style TargetType="ui:TitleBar" BasedOn="{StaticResource {x:Type ui:TitleBar}}">
		<Setter Property="Panel.ZIndex" Value="1" />
		<Setter Property="Margin" Value="48,0,0,0" />
	</Style>
	<Style x:Key="TopPageItem" TargetType="ui:NavigationViewItem"
			BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}"
			xmlns:TopPage="clr-namespace:ShinroKensakuDesktop.Pages.TopPage">
		<Setter Property="TargetPageType" Value="TopPage:TopPage" />
		<Setter Property="Tag" Value="TopPage" />
		<Setter Property="Icon" Value="{ui:SymbolIcon Symbol=Home12}" />
	</Style>
	<Style x:Key="SearchPageItem" TargetType="ui:NavigationViewItem"
			BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}"
			xmlns:SearchPage="clr-namespace:ShinroKensakuDesktop.Pages.SearchPage">
		<Setter Property="TargetPageType" Value="SearchPage:SearchPage" />
		<Setter Property="Tag" Value="SearchPage" />
		<Setter Property="Icon" Value="{ui:SymbolIcon Symbol=Search12}" />
	</Style>
	<Style x:Key="InfoPageItem" TargetType="ui:NavigationViewItem"
			BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}"
			xmlns:InfoPage="clr-namespace:ShinroKensakuDesktop.Pages.InfoPage">
		<Setter Property="TargetPageType" Value="InfoPage:InfoPage" />
		<Setter Property="Tag" Value="InfoPage" />
		<Setter Property="Icon" Value="{ui:SymbolIcon Symbol=QuestionCircle12}" />
	</Style>
</ResourceDictionary>