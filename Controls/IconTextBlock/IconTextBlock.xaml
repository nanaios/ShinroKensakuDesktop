<UserControl x:Class="ShinroKensakuDesktop.Controls.IconTextBlock.IconTextBlock"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:local="clr-namespace:ShinroKensakuDesktop.Controls.IconTextBlock"
			 mc:Ignorable="d" 
			 x:Name="Root"
			 d:DesignHeight="100" d:DesignWidth="400">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="{Binding ActualHeight, ElementName=Root}"/>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>
		<Path HorizontalAlignment="Left" Stretch="Fill" Fill="{Binding Foreground, ElementName=Root}" Data="{Binding IconPath, ElementName=Root}"/>
		<TextBlock Grid.Column="1" Foreground="{Binding Foreground, ElementName=Root}" Margin="10,0,0,0" Text="{Binding Text, ElementName=Root}" FontFamily="Noto Sans JP" FontSize="48" FontWeight="Light" VerticalAlignment="Center"/>
	</Grid>
</UserControl>
