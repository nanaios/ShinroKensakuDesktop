<UserControl x:Class="ShinroKensakuDesktop.Controls.InputField.InputField"
			 x:Name="InputFieldControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:local="clr-namespace:ShinroKensakuDesktop.Controls.InputField"
			 mc:Ignorable="d" 
			 d:DesignHeight="120" d:DesignWidth="800">
	<Grid>
		<Rectangle RadiusX="40" RadiusY="40" Stroke="{DynamicResource MainColor1}" StrokeThickness="8" />
		<TextBlock x:Name="Placeholder" Text="{Binding Path=PlaceholderText, ElementName=InputFieldControl}"
				   Background="{x:Null}"
				   FontFamily="Noto Sans JP" FontSize="50" FontWeight="Medium"
				   Foreground="#FFBEBEBE" Padding="20,0,20,0"
				   LineHeight="16" VerticalAlignment="Center"
		/>
		<TextBox x:Name="InputFieldBox"
				 Background="Transparent"  BorderBrush="Transparent" CaretBrush="{DynamicResource MainColor1}"
				 FontFamily="Noto Sans JP" FontSize="50" FontWeight="Medium" 
				 Foreground="{DynamicResource MainColor1}"
				 VerticalContentAlignment="Center" Padding="20,0,20,0"
				 GotKeyboardFocus="InputFieldBox_GotKeyboardFocus" LostKeyboardFocus="InputFieldBox_LostKeyboardFocus" KeyDown="InputFieldBox_KeyDown" BorderThickness="0,0,0,0"
		/>
	</Grid>
</UserControl>
