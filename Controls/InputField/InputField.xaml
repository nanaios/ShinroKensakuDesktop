<UserControl x:Class="ShinroKensakuDesktop.Controls.InputField.InputField"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:local="clr-namespace:ShinroKensakuDesktop.Controls.InputField"
			 mc:Ignorable="d" 
			 d:DesignHeight="120" d:DesignWidth="800">
	<Grid>
			<Rectangle RadiusX="40" RadiusY="40" Stroke="{DynamicResource MainColor1}" StrokeThickness="8" />
			<TextBox Background="{x:Null}" BorderBrush="{x:Null}" FontFamily="Noto Sans JP" FontSize="50" FontWeight="Medium" Foreground="{DynamicResource MainColor1}" Text="進路先名を入力..." VerticalContentAlignment="Center" Padding="20,0,20,0" />
	</Grid>
</UserControl>
