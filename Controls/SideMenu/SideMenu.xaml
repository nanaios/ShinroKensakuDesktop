<UserControl x:Name="Root" x:Class="ShinroKensakuDesktop.Controls.SideMenu.SideMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShinroKensakuDesktop.Controls.SideMenu"
             mc:Ignorable="d" 
             d:DesignHeight="1024" d:DesignWidth="480" Foreground="{x:Null}">
	<UserControl.Resources>
		<local:BooleanToMenuButtonPathGeometryConverter
			x:Key="BooleanToMenuButtonPathGeometryConverter" 
			CloseIconGeometry="{StaticResource CloseIconPath}"
			OpenIconGeometry="{StaticResource MenuIconPath}"
			/>
	</UserControl.Resources>
	<Grid x:Name="MainGrid" ClipToBounds="True">
		<Grid.DataContext>
			<local:ViewModel/>
		</Grid.DataContext>
		<Rectangle x:Name="BackGround" Fill="{DynamicResource MainColor2}" Margin="-80,0,80,0" RadiusX="30" RadiusY="30"/>
		<Button 
			Command="{Binding ButtonClickCommand}"
			Width="60" Height="60" HorizontalAlignment="Right" VerticalAlignment="Top" 
			Margin="0,60,0,0" Padding="0,0,0,0" 
			BorderBrush="{x:Null}" Background="{x:Null}" Foreground="{x:Null}" 	
		>
			<Path 
			Fill="{DynamicResource MainColor2}"
			Data="{Binding IsOpen,Converter={StaticResource BooleanToMenuButtonPathGeometryConverter}}" 
			 Stretch="Fill" />
		</Button>
	</Grid>
</UserControl>
