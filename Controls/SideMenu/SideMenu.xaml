<UserControl xmlns:IconTextBlock="clr-namespace:ShinroKensakuDesktop.Controls.IconTextBlock"  x:Name="Root" x:Class="ShinroKensakuDesktop.Controls.SideMenu.SideMenu"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:local="clr-namespace:ShinroKensakuDesktop.Controls.SideMenu"
			 mc:Ignorable="d" 
			 d:DesignHeight="1024" d:DesignWidth="400" Foreground="{x:Null}">
	<UserControl.Resources>
		<local:PathGeometryConverter CloseIconGeometry="{StaticResource CloseIconPath}" OpenIconGeometry="{StaticResource MenuIconPath}" x:Key="PathGeometryConverter"/>
	</UserControl.Resources>
	<Grid x:Name="MainGrid" ClipToBounds="True">
		<Rectangle x:Name="BackGround" Fill="{DynamicResource MainColor2}" Margin="-80,0,80,0" RadiusX="30" RadiusY="30"/>
		<Grid  Margin="15,100,80,100">
			<Grid.RowDefinitions>
				<RowDefinition Height="{Binding MenuContentMarginWidth, ElementName=Root}"/>
				<RowDefinition Height="{Binding MenuContentWidth, ElementName=Root}"/>
				<RowDefinition Height="{Binding MenuContentMarginWidth, ElementName=Root}"/>
				<RowDefinition Height="{Binding MenuContentWidth, ElementName=Root}"/>
				<RowDefinition Height="{Binding MenuContentMarginWidth, ElementName=Root}"/>
				<RowDefinition Height="{Binding MenuContentWidth, ElementName=Root}"/>
			</Grid.RowDefinitions>
			<IconTextBlock:IconTextBlock Foreground="White" Grid.Row="1" Text="ホーム" IconPath="{DynamicResource HomeIconPath}"/>
			<IconTextBlock:IconTextBlock Foreground="White" Grid.Row="3" Text="詳細検索" IconPath="{DynamicResource ArticleIconPath}"/>
			<IconTextBlock:IconTextBlock Foreground="White" Grid.Row="5" Text="ヘルプ" IconPath="{DynamicResource HelpIconPath}"/>
		</Grid>
		<Button
			Width="60" Height="60" HorizontalAlignment="Right" VerticalAlignment="Top" 
			Margin="0,60,0,0" Padding="0,0,0,0" 
			BorderBrush="{x:Null}" Background="{x:Null}" Foreground="{x:Null}" Click="Button_Click" 	
		>
			<Grid>
				<Rectangle Fill="Transparent"/>
				<Path 
				Fill="{DynamicResource MainColor2}"
				Data="{Binding IsOpen,ElementName=Root,Converter={StaticResource PathGeometryConverter}}" 
				Stretch="Fill" />
			</Grid>
		</Button>
	</Grid>
</UserControl>
