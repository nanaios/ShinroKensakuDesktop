<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
		xmlns:local="clr-namespace:ShinroKensakuDesktop.Views.Windows"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
		xmlns:vm="clr-namespace:ShinroKensakuDesktop.ViewModels.Windows"
		d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=True}"
		x:Class="ShinroKensakuDesktop.Views.Windows.MainWindow" Width="1440" Height="1080">
	<ui:FluentWindow.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Views/Windows/MainWindowStyle.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</ui:FluentWindow.Resources>
	<Grid x:Name="Root">
		<ui:TitleBar x:Name="WindowTitle" Title="{Binding Title}" />
		<ui:NavigationView x:Name="MainView">
			<ui:NavigationView.MenuItems>
				<ui:NavigationViewItem Style="{StaticResource DashBoardPageItem}">ダッシュボード</ui:NavigationViewItem>
			</ui:NavigationView.MenuItems>
			<ui:NavigationView.FooterMenuItems>
				<ui:NavigationViewItem Style="{StaticResource SettingsPageItem}">設定</ui:NavigationViewItem>
			</ui:NavigationView.FooterMenuItems>
		</ui:NavigationView>
	</Grid>
</ui:FluentWindow>