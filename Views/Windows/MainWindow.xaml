<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
		xmlns:local="clr-namespace:ShinroKensakuDesktop.Views.Windows"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
		xmlns:vm="clr-namespace:ShinroKensakuDesktop.ViewModels.Windows"
		d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=True}"
		x:Class="ShinroKensakuDesktop.Views.Windows.MainWindow" Width="1440" Height="1080">
	<Grid x:Name="Root">
		<ui:TitleBar x:Name="WindowTitle" Title="{Binding Title}" Margin="48,0,0,0" Panel.ZIndex="1" />
		<ui:NavigationView
				MaxHeight="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Grid}}"
				x:Name="MainView" xmlns:pages="clr-namespace:ShinroKensakuDesktop.Views.Pages"
				IsBackButtonVisible="Visible" IsFooterSeparatorVisible="False" IsPaneToggleVisible="True"
				IsTopSeparatorVisible="False" OpenPaneLength="200" PaneDisplayMode="Left"
				IsPaneOpen="False" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" Grid.Row="4"
				FrameMargin="0,48,0,0">
			<ui:NavigationView.MenuItems>
				<ui:NavigationViewItem TargetPageType="pages:DashBoardPage" Content="ダッシュボード" Tag="DashBoard"
						Icon="{ui:SymbolIcon Symbol=Home12}" />
				<ui:NavigationViewItem TargetPageType="pages:SearchPage" Content="検索" Tag="Search"
						Icon="{ui:SymbolIcon Symbol=Search12}" />
			</ui:NavigationView.MenuItems>
			<ui:NavigationView.FooterMenuItems>
				<ui:NavigationViewItem TargetPageType="pages:SettingsPage" Content="設定" Tag="Settings"
						Icon="{ui:SymbolIcon Symbol=Settings16}" />
			</ui:NavigationView.FooterMenuItems>
		</ui:NavigationView>
	</Grid>
</ui:FluentWindow>