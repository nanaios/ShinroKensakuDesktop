<Page xmlns:charts="clr-namespace:ShinroKensakuDesktop.Views.Controls"
      xmlns:behaviors="clr-namespace:ShinroKensakuDesktop.Views.Behaviors"
      xmlns:models="clr-namespace:ShinroKensakuDesktop.Models"
      x:Class="ShinroKensakuDesktop.Views.Pages.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="進路グラフ" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <!-- 未設定 is not a real department, so it sits under a divider in the secondary colour. -->
        <DataTemplate x:Key="DepartmentItem">
            <Border x:Name="Item" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <TextBlock x:Name="Name" Text="{Binding}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static models:DashboardDataProvider.Unassigned}">
                    <Setter TargetName="Name" Property="Foreground"
                            Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter TargetName="Item" Property="BorderThickness" Value="0,1,0,0" />
                    <Setter TargetName="Item" Property="Padding" Value="0,6,0,0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="ChartTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Subtitle" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <!-- Filters and totals stay put; only the charts scroll, so every chart is read with its conditions in view. -->
    <Grid x:Name="AnalyticsLayout" Height="0" behaviors:NavigationViewport.Fit="True"
          Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="32,24,32,0">
            <DockPanel Style="{StaticResource PageHeader}">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource CaptionText}" Margin="0,0,12,0" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise20, FontSize=20}"
                               Style="{StaticResource IconActionButton}"
                               ToolTip="再読み込み" AutomationProperties.Name="再読み込み"
                               Command="{Binding RefreshCommand}" />
                </StackPanel>
                <ui:TextBlock Text="進路グラフ" FontTypography="Title" VerticalAlignment="Center" />
            </DockPanel>
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,32,12">
                    <TextBlock Text="卒業年度" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding RangeStartYear}" MinWidth="104"
                              Style="{StaticResource YearSelector}" AutomationProperties.Name="表示する最初の卒業年度" />
                    <TextBlock Text="～" VerticalAlignment="Center" Margin="8,0" />
                    <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding RangeEndYear}" MinWidth="104"
                              Style="{StaticResource YearSelector}" AutomationProperties.Name="表示する最後の卒業年度" />
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="RangePreset" Content="直近5年度"
                                     IsChecked="{Binding IsRecentRange, Mode=OneWay}"
                                     Command="{Binding ShowRecentYearsCommand}"
                                     ToolTip="最新の卒業年度から5年度分" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="RangePreset" Content="全期間"
                                     IsChecked="{Binding IsAllRange, Mode=OneWay}"
                                     Command="{Binding ShowAllYearsCommand}"
                                     ToolTip="登録されているすべての卒業年度" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="学科" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}"
                              ItemTemplate="{StaticResource DepartmentItem}"
                              MinWidth="200" Style="{StaticResource YearSelector}"
                              AutomationProperties.Name="表示する学科" />
                    <charts:InfoTip Subject="学科の求め方"
                                    Text="学科はクラス名から学年を除いて求めます。クラスが登録されていない記録は「未設定」にまとめます。" />
                </StackPanel>
            </WrapPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}, ConverterParameter=Hide}" />
            <charts:NoticeBar Title="データを取得できませんでした" Message="{Binding ErrorText}"
                              Severity="{Binding HasError, Converter={StaticResource BoolToSeverity}, ConverterParameter=Error}">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="再読み込み" Command="{Binding RefreshCommand}" />
                    <ui:Button Content="接続設定を開く" Command="{Binding OpenSettingsCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </charts:NoticeBar>
            <charts:NoticeBar Title="登録されている受験記録はありません"
                              Severity="{Binding IsEmpty, Converter={StaticResource BoolToSeverity}, ConverterParameter=Info}" />
            <ItemsControl ItemsSource="{Binding RangeStats}" Style="{StaticResource StatList}" />
        </StackPanel>
        <ScrollViewer x:Name="ChartScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,0,32,32">
                <ui:Card Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <ui:TextBlock Text="卒業年度別の推移" Style="{StaticResource ChartTitle}" Margin="0,0,0,8" />
                        <charts:SeriesChartView Data="{Binding KindTrendChart}"
                                                PointCommand="{Binding OpenYearSearchCommand}" />
                    </StackPanel>
                </ui:Card>
                <Grid x:Name="MethodSection" SizeChanged="MethodSection_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:Card x:Name="MethodTrendCard" Style="{StaticResource SectionCard}" Grid.ColumnSpan="3"
                             VerticalAlignment="Stretch">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="MethodScale"
                                                 Content="件数"
                                                 IsChecked="{Binding ShowMethodShare, Converter={StaticResource InverseBool}}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="MethodScale"
                                                 Content="割合" Margin="0" IsChecked="{Binding ShowMethodShare}"
                                                 ToolTip="その年度の進学に占める割合" />
                                </StackPanel>
                                <ui:TextBlock Text="進学の受験方法別の推移" Style="{StaticResource ChartTitle}" />
                            </DockPanel>
                            <charts:SeriesChartView Data="{Binding MethodTrendChart}"
                                                    ShowShare="{Binding ShowMethodShare}"
                                                    PointCommand="{Binding OpenYearSearchCommand}" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card x:Name="MethodBreakdownCard" Style="{StaticResource SectionCard}" Grid.Row="1"
                             Grid.ColumnSpan="3" VerticalAlignment="Stretch">
                        <StackPanel>
                            <ui:TextBlock Text="受験方法別の件数" Style="{StaticResource ChartTitle}" Margin="0,0,0,12" />
                            <ItemsControl x:Name="MethodBreakdownList" ItemsSource="{Binding MethodBreakdown}"
                                          Focusable="False" AutomationProperties.Name="受験方法別の件数" />
                            <TextBlock Text="選択した範囲に表示できるデータがありません。" Style="{StaticResource SecondaryText}"
                                       Margin="0,16"
                                       Visibility="{Binding MethodBreakdown.Count, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
