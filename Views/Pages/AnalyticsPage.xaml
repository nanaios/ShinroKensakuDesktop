<Page xmlns:charts="clr-namespace:ShinroKensakuDesktop.Views.Controls"
      xmlns:behaviors="clr-namespace:ShinroKensakuDesktop.Views.Behaviors"
      x:Class="ShinroKensakuDesktop.Views.Pages.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="進路グラフ" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Page.Resources>
    <ScrollViewer behaviors:NavigationViewport.Fit="True" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
        <StackPanel Margin="36,20,36,32">
            <ui:TextBlock Text="進路グラフ" FontTypography="Title" Margin="0,0,0,24" />
            <WrapPanel Margin="0,0,0,16">
                <TextBlock Text="表示する年度" VerticalAlignment="Center" Margin="0,0,12,8" />
                <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding RangeStartYear}" MinWidth="120"
                          Style="{StaticResource YearSelector}"
                          Margin="0,0,8,8" AutomationProperties.Name="表示する最初の年度" />
                <TextBlock Text="～" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding RangeEndYear}" MinWidth="120"
                          Style="{StaticResource YearSelector}"
                          Margin="0,0,16,8" AutomationProperties.Name="表示する最後の年度" />
                <ui:Button Content="直近5年度" Command="{Binding ShowRecentYearsCommand}" Margin="0,0,8,8"
                           ToolTip="最新の登録年度から5年度分を表示" />
                <ui:Button Content="全期間" Command="{Binding ShowAllYearsCommand}" Margin="0,0,12,8"
                           ToolTip="登録されている全年度を表示" />
                <ui:Button Icon="{ui:SymbolIcon ArrowClockwise20, FontSize=20}"
                           Style="{StaticResource IconActionButton}"
                           ToolTip="再読み込み" AutomationProperties.Name="再読み込み"
                           Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,16">
                <TextBlock Text="学科" VerticalAlignment="Center" Margin="0,0,12,8" />
                <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" MinWidth="200"
                          Style="{StaticResource YearSelector}"
                          Margin="0,0,0,8" AutomationProperties.Name="表示する学科" />
            </WrapPanel>
            <ProgressBar IsIndeterminate="True" Height="3"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <TextBlock Text="件数は受験記録単位です。同じ生徒の複数回受験を含みます。"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />
            <ui:TextBlock Text="{Binding RangeCaption}" FontTypography="BodyStrong" Margin="0,0,0,12" />
            <WrapPanel>
                <ui:Card Width="240" Margin="0,0,16,16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="受験記録の総数" />
                        <TextBlock Text="{Binding RangeTotalText}" FontSize="36" FontWeight="SemiBold" Margin="0,12,0,0" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Width="240" Margin="0,0,16,16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="進学の受験記録" />
                        <TextBlock Text="{Binding RangeStudyText}" FontSize="36" FontWeight="SemiBold" Margin="0,12,0,0" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Width="240" Margin="0,0,16,16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="就職の受験記録" />
                        <TextBlock Text="{Binding RangeWorkText}" FontSize="36" FontWeight="SemiBold" Margin="0,12,0,0" />
                    </StackPanel>
                </ui:Card>
            </WrapPanel>
            <ui:Card Padding="24" Margin="0,0,0,16" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <ui:TextBlock Text="年度別の推移（合計・進学・就職）" FontTypography="Subtitle" />
                    <TextBlock Text="{Binding PointHint}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,12" />
                    <charts:SeriesChartView Data="{Binding KindTrendChart}" Kind="Line"
                                            PointCommand="{Binding OpenYearSearchCommand}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Padding="24" Margin="0,0,0,16" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <ui:TextBlock Text="受験方法別の推移" FontTypography="Subtitle" Margin="0,0,0,12" />
                    <charts:SeriesChartView Data="{Binding MethodTrendChart}" Kind="Line"
                                            PointCommand="{Binding OpenYearSearchCommand}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Padding="24" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <ui:TextBlock Text="受験方法別の件数（選択範囲の合計）" FontTypography="Subtitle" Margin="0,0,0,12" />
                    <charts:SeriesChartView Data="{Binding MethodBreakdownChart}" Kind="StackedBar" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>