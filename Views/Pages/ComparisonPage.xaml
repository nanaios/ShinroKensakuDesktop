<Page xmlns:behaviors="clr-namespace:ShinroKensakuDesktop.Views.Behaviors"
      xmlns:controls="clr-namespace:ShinroKensakuDesktop.Views.Controls"
      xmlns:models="clr-namespace:ShinroKensakuDesktop.Models"
      x:Class="ShinroKensakuDesktop.Views.Pages.ComparisonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="年度比較" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeaderCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- Columns shared by the header and every row. -->
        <Style x:Key="ComparisonColumns" TargetType="Grid">
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <!-- A method row: kind icon, both years, the change with its arrow, a bar growing left (fewer) or right (more). -->
        <DataTemplate x:Key="MethodRow" DataType="{x:Type models:MethodComparisonRow}">
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid Style="{StaticResource ComparisonColumns}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" /><ColumnDefinition MinWidth="96" />
                        <ColumnDefinition Width="80" /><ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" /><ColumnDefinition Width="200" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon x:Name="KindIcon" Symbol="HatGraduation24" FontSize="18"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource StudyBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                    <TextBlock Grid.Column="2" Text="{Binding Baseline, StringFormat=N0}"
                               Style="{StaticResource NumberCell}" />
                    <TextBlock Grid.Column="3" Text="{Binding Current, StringFormat=N0}"
                               Style="{StaticResource NumberCell}" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:SymbolIcon x:Name="Arrow" Symbol="CaretUp16" Filled="True" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,2,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ChangeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Column="5" Margin="16,0,0,0" VerticalAlignment="Center" Height="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="{Binding DecreaseRatio, Converter={StaticResource RatioToStar}, ConverterParameter=Rest}" />
                                <ColumnDefinition
                                    Width="{Binding DecreaseRatio, Converter={StaticResource RatioToStar}}" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Decrease" Grid.Column="1" CornerRadius="2,0,0,2"
                                    Background="{DynamicResource StudyBrush}" />
                        </Grid>
                        <Border Grid.Column="1" Background="{DynamicResource TextFillColorTertiaryBrush}"
                                Margin="0,-4" />
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="{Binding IncreaseRatio, Converter={StaticResource RatioToStar}}" />
                                <ColumnDefinition
                                    Width="{Binding IncreaseRatio, Converter={StaticResource RatioToStar}, ConverterParameter=Rest}" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Increase" CornerRadius="0,2,2,0" Background="{DynamicResource StudyBrush}" />
                        </Grid>
                    </Grid>
                    <TextBlock Grid.Column="6" Text="{Binding RateText}" Style="{StaticResource NumberCell}"
                               ToolTip="{Binding RateTip}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StatKind.Work}">
                    <Setter TargetName="KindIcon" Property="Symbol" Value="Briefcase24" />
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource WorkBrush}" />
                    <Setter TargetName="Decrease" Property="Background" Value="{DynamicResource WorkBrush}" />
                    <Setter TargetName="Increase" Property="Background" Value="{DynamicResource WorkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:ChangeDirection.Up}">
                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:ChangeDirection.Down}">
                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Arrow" Property="Symbol" Value="CaretDown16" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="CardLink" TargetType="ui:HyperlinkButton" BasedOn="{StaticResource {x:Type ui:HyperlinkButton}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer behaviors:NavigationViewport.Fit="True" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
        <StackPanel Margin="{StaticResource PagePadding}">
            <DockPanel Style="{StaticResource PageHeader}">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource CaptionText}" Margin="0,0,12,0" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise20, FontSize=20}"
                               Style="{StaticResource IconActionButton}"
                               ToolTip="再読み込み" AutomationProperties.Name="再読み込み"
                               Command="{Binding RefreshCommand}" />
                </StackPanel>
                <ui:TextBlock Text="年度比較" FontTypography="Title" VerticalAlignment="Center" />
            </DockPanel>
            <WrapPanel Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="基準年度" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding BaselineYear}" MinWidth="112"
                              Style="{StaticResource YearSelector}" AutomationProperties.Name="基準年度" />
                </StackPanel>
                <ui:Button Icon="{ui:SymbolIcon ArrowSwap20, FontSize=20}" Style="{StaticResource IconActionButton}"
                           ToolTip="基準年度と比較年度を入れ替える" AutomationProperties.Name="基準年度と比較年度を入れ替える"
                           Command="{Binding SwapYearsCommand}" Margin="12,0,12,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="比較年度" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" MinWidth="112"
                              Style="{StaticResource YearSelector}" AutomationProperties.Name="比較年度" />
                </StackPanel>
                <TextBlock Text="同じ年度を選んでいます" Style="{StaticResource CaptionText}" Margin="16,0,0,12"
                           Visibility="{Binding IsSameYear, Converter={StaticResource BoolVisibility}}" />
            </WrapPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}, ConverterParameter=Hide}" />
            <controls:NoticeBar Title="データを取得できませんでした" Message="{Binding ErrorText}"
                                Severity="{Binding HasError, Converter={StaticResource BoolToSeverity}, ConverterParameter=Error}">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="再読み込み" Command="{Binding RefreshCommand}" />
                    <ui:Button Content="接続設定を開く" Command="{Binding OpenSettingsCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </controls:NoticeBar>
            <controls:NoticeBar Title="登録されている受験記録はありません"
                                Severity="{Binding IsEmpty, Converter={StaticResource BoolToSeverity}, ConverterParameter=Info}" />
            <ItemsControl ItemsSource="{Binding ComparisonStats}" Style="{StaticResource StatList}" />
            <ui:Card Style="{StaticResource SectionCard}" Margin="0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <ui:HyperlinkButton Style="{StaticResource CardLink}" Command="{Binding OpenBaselineSearchCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding BaselineSearchText}" />
                                    <ui:SymbolIcon Symbol="ChevronRight12" Margin="4,1,0,0" />
                                </StackPanel>
                            </ui:HyperlinkButton>
                            <ui:HyperlinkButton Style="{StaticResource CardLink}" Command="{Binding OpenSearchCommand}"
                                                Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedSearchText}" />
                                    <ui:SymbolIcon Symbol="ChevronRight12" Margin="4,1,0,0" />
                                </StackPanel>
                            </ui:HyperlinkButton>
                        </StackPanel>
                        <ui:TextBlock Text="受験方法別の増減（件）" FontTypography="Subtitle" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="680">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                <Grid Style="{StaticResource ComparisonColumns}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" /><ColumnDefinition MinWidth="96" />
                                        <ColumnDefinition Width="80" /><ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" /><ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="受験方法" Style="{StaticResource HeaderCell}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="2" Text="{Binding BaselineYear, StringFormat={}{0}年度}"
                                               Style="{StaticResource HeaderCell}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SelectedYear, StringFormat={}{0}年度}"
                                               Style="{StaticResource HeaderCell}" />
                                    <TextBlock Grid.Column="4" Text="増減" Style="{StaticResource HeaderCell}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center"
                                                Margin="16,0,0,0" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock Text="減" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="｜" FontSize="12" Margin="24,0" VerticalAlignment="Center" />
                                        <TextBlock Text="増" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="増減率" Style="{StaticResource HeaderCell}" />
                                        <controls:InfoTip Subject="増減率" Margin="2,0,-4,0"
                                                          Text="（比較年度 − 基準年度）÷ 基準年度。基準年度が0件の場合は算出しません。" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding MethodComparisons}"
                                          ItemTemplate="{StaticResource MethodRow}" Focusable="False"
                                          AutomationProperties.Name="受験方法別の増減" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
