<Page xmlns:behaviors="clr-namespace:ShinroKensakuDesktop.Views.Behaviors"
      xmlns:controls="clr-namespace:ShinroKensakuDesktop.Views.Controls"
      x:Class="ShinroKensakuDesktop.Views.Pages.ComparisonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="年度比較" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>
    </Page.Resources>
    <ScrollViewer behaviors:NavigationViewport.Fit="True" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
        <StackPanel Margin="36,20,36,32">
            <DockPanel Style="{StaticResource PageHeader}">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise20, FontSize=20}"
                               Style="{StaticResource IconActionButton}"
                               ToolTip="再読み込み" AutomationProperties.Name="再読み込み"
                               Command="{Binding RefreshCommand}" />
                    <ui:Button Icon="{ui:SymbolIcon Search20, FontSize=20}" Style="{StaticResource IconActionButton}"
                               ToolTip="対象年度の検索・明細を開く" AutomationProperties.Name="対象年度の検索・明細を開く"
                               Command="{Binding OpenSearchCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="年度比較" FontTypography="Title" />
                    <controls:InfoTip Margin="8,4,0,0"
                                      Text="2つの年度の件数と増減を比べます。件数は受験記録単位で、同じ生徒の複数回受験を含みます。選択は進路グラフの表示範囲とは独立しています。" />
                </StackPanel>
            </DockPanel>
            <WrapPanel Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="比較元" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding BaselineYear}" MinWidth="120"
                              Style="{StaticResource YearSelector}" AutomationProperties.Name="比較元年度" />
                </StackPanel>
                <ui:SymbolIcon Symbol="ArrowRight20" FontSize="16" VerticalAlignment="Center" Margin="16,0,16,12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="対象" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" MinWidth="120"
                              Style="{StaticResource YearSelector}" AutomationProperties.Name="比較対象年度" />
                </StackPanel>
            </WrapPanel>
            <ProgressBar IsIndeterminate="True" Height="3"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
            <ui:Card Style="{StaticResource SectionCard}" Margin="0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel MinWidth="600">
                        <Border BorderThickness="0,0,0,1" Padding="0,0,0,10"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <Grid TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="区分" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="比較元（件）" FontWeight="SemiBold"
                                           Style="{StaticResource NumberCell}" />
                                <TextBlock Grid.Column="2" Text="対象（件）" FontWeight="SemiBold"
                                           Style="{StaticResource NumberCell}" />
                                <TextBlock Grid.Column="3" Text="増減" FontWeight="SemiBold"
                                           Style="{StaticResource NumberCell}" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <TextBlock Text="増減率" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <controls:InfoTip Text="（対象 − 比較元）÷ 比較元。比較元が0件の場合は算出しません。" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Comparisons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" Padding="0,12"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                                <ColumnDefinition /><ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Baseline, StringFormat=N0}"
                                                       Style="{StaticResource NumberCell}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Current, StringFormat=N0}"
                                                       Style="{StaticResource NumberCell}" />
                                            <TextBlock Grid.Column="3" Text="{Binding DifferenceText}"
                                                       Style="{StaticResource NumberCell}" />
                                            <TextBlock Grid.Column="4" Text="{Binding RateText}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
