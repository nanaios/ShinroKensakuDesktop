<Page x:Class="ShinroKensakuDesktop.Views.Pages.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:behaviors="clr-namespace:ShinroKensakuDesktop.Views.Behaviors"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      Title="検索" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Page.Resources>
    <Grid x:Name="SearchLayout" Height="0" behaviors:NavigationViewport.Fit="True" Margin="24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <DockPanel Margin="0,8">
                <ui:Button Content="検索" Command="{Binding ExecuteSearchCommand}" Appearance="Primary"
                           DockPanel.Dock="Right" Margin="8,0,0,0" />
                <ui:AutoSuggestBox Text="{Binding SearchTargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   PlaceholderText="進路先を入力" />
            </DockPanel>
            <Expander Header="検索条件" Margin="0,0,0,8">
                <WrapPanel>
                    <StackPanel Width="180" Margin="0,4,8,4">
                        <TextBlock Text="年度" Margin="0,0,0,4" />
                        <DockPanel>
                            <ui:Button Content="×" Command="{Binding ClearSelectedYearCommand}" DockPanel.Dock="Right"
                                       Padding="8,4" />
                            <TextBox Text="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Behaviors>
                                    <behaviors:NumericOnlyBehavior />
                                </i:Interaction.Behaviors>
                            </TextBox>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,4,8,4">
                        <TextBlock Text="受験方法" Margin="0,0,0,4" />
                        <DockPanel>
                            <ui:Button Content="×" Command="{Binding ClearExamMethodComboBoxSelectedItemCommand}"
                                       DockPanel.Dock="Right" Padding="8,4" />
                            <ComboBox ItemsSource="{Binding ExamMethodComboBoxItems}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding ExamMethodComboBoxSelectedItem}" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,4,8,4">
                        <TextBlock Text="クラス" Margin="0,0,0,4" />
                        <DockPanel>
                            <ui:Button Content="×" Command="{Binding ClearDepartmentComboBoxSelectedItemCommand}"
                                       DockPanel.Dock="Right" Padding="8,4" />
                            <ComboBox ItemsSource="{Binding DepartmentComboBoxItems}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding DepartmentComboBoxSelectedItem}" />
                        </DockPanel>
                    </StackPanel>
                </WrapPanel>
            </Expander>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}"
                         AutomationProperties.Name="読み込み中" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,4,0,8">
            <ui:Button Content="検索結果をCSV保存" Command="{Binding ExportCsvCommand}" DockPanel.Dock="Right" />
            <TextBlock Text="{Binding SearchResultCountText}" VerticalAlignment="Center" />
        </DockPanel>
        <ui:DataGrid Grid.Row="2" Name="ResultGrid" HeadersVisibility="All" ItemsSource="{Binding SearchResultList}"
                     IsReadOnly="True" AutoGenerateColumns="False"
                     EnableRowVirtualization="True" EnableColumnVirtualization="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     RowHeight="36" ColumnWidth="140" CanUserAddRows="False" CanUserResizeRows="False"

                     VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="卒業年度" Width="100" Binding="{Binding Year}" />
                <DataGridTextColumn Header="受験日" Binding="{Binding Jyukenbi, StringFormat='yyyy/MM/dd'}" />
                <DataGridTextColumn Header="進路先" Width="260" Binding="{Binding Shinro_name}" />
                <DataGridTextColumn Header="学部" Binding="{Binding Gakubu}" />
                <DataGridTextColumn Header="学科" Binding="{Binding Gakka}" />
                <DataGridTextColumn Header="コース" Binding="{Binding Course}" />
                <DataGridTextColumn Header="就職先内区分" Binding="{Binding Syuusyokusakinai_kubun}" />
                <DataGridTextColumn Header="受験方法" Binding="{Binding Jyukenhouhou_name}" />
                <DataGridTextColumn Header="氏名" Binding="{Binding G_name}" />
                <DataGridTextColumn Header="性別" Binding="{Binding Sei}" />
                <DataGridTextColumn Header="クラス" Binding="{Binding Cls_name}" />
                <DataGridTextColumn Header="合否" Binding="{Binding Result}" />
            </DataGrid.Columns>
            <ui:DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="MinWidth" Value="50" />
                </Style>
            </ui:DataGrid.ColumnHeaderStyle>
        </ui:DataGrid>
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Margin="0,8" TextWrapping="Wrap" />
    </Grid>
</Page>