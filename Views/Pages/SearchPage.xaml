<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:ShinroKensakuDesktop.ViewModels.Pages"
		xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
		xmlns:converters="clr-namespace:ShinroKensakuDesktop.Views.Converters"
		xmlns:local="clr-namespace:ShinroKensakuDesktop.Views.Pages"
		xmlns:behaviors="clr-namespace:ShinroKensakuDesktop.Views.Behaviors"
		d:DataContext="{d:DesignInstance Type=vm:SearchPageViewModel, IsDesignTimeCreatable=True}"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
		mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1440"
		ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
		ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}" Title="Search"
		ScrollViewer.CanContentScroll="False" x:Class="ShinroKensakuDesktop.Views.Pages.SearchPage">
	<Page.Resources>
		<Style TargetType="Grid" x:Key="ConditionContentGridStyle">
			<Setter Property="Margin" Value="10,10,10,10" />
		</Style>
		<Style TargetType="ui:TextBlock" x:Key="ConditionContentTextStyle">
			<Setter Property="FontTypography" Value="BodyStrong" />
			<Setter Property="Margin" Value="0,0,0,5" />
		</Style>
		<Style TargetType="ui:Button" x:Key="ConditionContentButtonStyle" BasedOn="{StaticResource {x:Type ui:Button}}">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="VerticalAlignment" Value="Stretch" />
			<Setter Property="CornerRadius" Value="0,5,5,0" />
		</Style>
		<Style TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}"
				x:Key="ConditionContentNumberBoxStyle">
		</Style>
	</Page.Resources>
	<Grid Margin="48,0,48,0">
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition Height="auto" />
			<RowDefinition />
			<RowDefinition Height="auto" />
		</Grid.RowDefinitions>
		<ui:Card Grid.Row="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
			<Grid Margin="8,0,8,0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<ui:AutoSuggestBox PlaceholderText="進路先を入力" Text="{Binding SearchTargetName, Mode=TwoWay}" />
				<ui:CardExpander Margin="0,5,0,5" Grid.Row="1" IsExpanded="False">
					<ui:CardExpander.Header>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>
							<ui:TextBlock Text="適応中の条件：" FontTypography="BodyStrong" />
							<ui:TextBlock Text="{Binding CurrentSearchQuery}" Grid.Column="1"
									FontTypography="BodyStrong" />
						</Grid>
					</ui:CardExpander.Header>
					<WrapPanel Grid.Row="1" ItemWidth="400">
						<Grid Style="{StaticResource ConditionContentGridStyle}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<ui:TextBlock Text="年度" Style="{StaticResource ConditionContentTextStyle}" Margin="0,0,0,5"
									Width="380" />
							<Grid Grid.Row="1" ClipToBounds="True">
								<TextBox Name="YearBox" Grid.Row="1" Text="{Binding SelectedYear, Mode=TwoWay}"
										Margin="0,0,-5,0">
									<i:Interaction.Behaviors>
										<behaviors:NumericOnlyBehavior />
									</i:Interaction.Behaviors>
								</TextBox>
							</Grid>
							<ui:Button Grid.Column="1" Grid.Row="1" Style="{StaticResource ConditionContentButtonStyle}"
									Icon="{ui:SymbolIcon Dismiss24}">
								<i:Interaction.Triggers>
									<i:EventTrigger EventName="Click">
										<i:InvokeCommandAction Command="{Binding ClearSelectedYearCommand}" />
									</i:EventTrigger>
								</i:Interaction.Triggers>
							</ui:Button>
						</Grid>
						<Grid Style="{StaticResource ConditionContentGridStyle}">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<ui:TextBlock Text="受験方法" Style="{StaticResource ConditionContentTextStyle}" />
							<Grid Grid.Row="1" ClipToBounds="True">
								<ComboBox Name="ExamMethodComboBox" Grid.Row="1"
										ItemsSource="{Binding ExamMethodComboBoxItems}" DisplayMemberPath="Name"
										SelectedItem="{Binding ExamMethodComboBoxSelectedItem, Mode=TwoWay}"
										Margin="0,0,-5,0">
								</ComboBox>

							</Grid>
							<ui:Button Grid.Column="1" Grid.Row="1" Style="{StaticResource ConditionContentButtonStyle}"
									Icon="{ui:SymbolIcon Dismiss24}">
								<i:Interaction.Triggers>
									<i:EventTrigger EventName="Click">
										<i:InvokeCommandAction
												Command="{Binding ClearExamMethodComboBoxSelectedItemCommand}" />
									</i:EventTrigger>
								</i:Interaction.Triggers>
							</ui:Button>
						</Grid>

						<Grid Style="{StaticResource ConditionContentGridStyle}">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<ui:TextBlock Text="クラス" Style="{StaticResource ConditionContentTextStyle}" />
							<Grid Grid.Row="1" ClipToBounds="True">
								<ComboBox Name="DepartmentComboBox" Grid.Row="1"
										ItemsSource="{Binding DepartmentComboBoxItems}"
										SelectedItem="{Binding DepartmentComboBoxSelectedItem, Mode=TwoWay}"
										Margin="0,0,-5,0">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock>
												<Run Text="{Binding Name}" />
												<Run Text=" (" />
												<Run Text="{Binding LongName}" />
												<Run Text=")" />
											</TextBlock>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</Grid>

							<ui:Button Grid.Column="1" Grid.Row="1" Style="{StaticResource ConditionContentButtonStyle}"
									Icon="{ui:SymbolIcon Dismiss24}">
								<i:Interaction.Triggers>
									<i:EventTrigger EventName="Click">
										<i:InvokeCommandAction
												Command="{Binding ClearDepartmentComboBoxSelectedItemCommand}" />
									</i:EventTrigger>
								</i:Interaction.Triggers>
							</ui:Button>
						</Grid>
					</WrapPanel>
				</ui:CardExpander>
				<ui:Button Grid.Row="2" Icon="{ui:SymbolIcon Search24}" HorizontalAlignment="Right" Appearance="Primary"
						Content="検索">
					<i:Interaction.Triggers>
						<i:EventTrigger EventName="Click">
							<i:InvokeCommandAction Command="{Binding ExecuteSearchCommand}" />
						</i:EventTrigger>
					</i:Interaction.Triggers>
				</ui:Button>
			</Grid>
		</ui:Card>
		<StackPanel Grid.Row="1" Margin="0,5,0,5" Orientation="Horizontal" HorizontalAlignment="Right">
			<ui:TextBlock Text="表示件数：" VerticalAlignment="Center" FontTypography="BodyStrong" />
			<TextBox Text="{Binding ResultVisibleCountLimit, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
					MinWidth="60" VerticalAlignment="Center" TextAlignment="Right">
				<i:Interaction.Behaviors>
					<behaviors:NumericOnlyBehavior />
				</i:Interaction.Behaviors>
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="LostFocus">
						<i:InvokeCommandAction Command="{Binding FirstPageCommand}" />
					</i:EventTrigger>
					<i:KeyTrigger Key="Enter">
						<i:InvokeCommandAction Command="{Binding FirstPageCommand}" />
					</i:KeyTrigger>
				</i:Interaction.Triggers>
			</TextBox>
			<ui:TextBlock Text=" 件" VerticalAlignment="Center" FontTypography="BodyStrong" />
		</StackPanel>
		<ui:Card Grid.Row="2" Margin="0,0,0,0" ClipToBounds="True" VerticalContentAlignment="Stretch"
				VerticalAlignment="Stretch">
			<ui:DataGrid Grid.Row="0" Name="ResultGrid" HeadersVisibility="All" ItemsSource="{Binding SearchResultList}"
					IsReadOnly="True" AutoGenerateColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Visible"
					VerticalAlignment="Top">
				<DataGrid.Columns>
					<DataGridTextColumn Header="卒業年度" Binding="{Binding Year}" />
					<DataGridTextColumn Header="受験日" Binding="{Binding Jyukenbi, StringFormat='yyyy/MM/dd'}" />
					<DataGridTextColumn Header="進路先" Binding="{Binding Shinro_name}" />
					<DataGridTextColumn Header="学部" Binding="{Binding Gakubu}" />
					<DataGridTextColumn Header="学科" Binding="{Binding Gakka}" />
					<DataGridTextColumn Header="コース" Binding="{Binding Course}" />
					<DataGridTextColumn Header="就職先内区分" Binding="{Binding Syuusyokusakinai_kubun}" />
					<DataGridTextColumn Header="受験方法" Binding="{Binding Jyukenhouhou_name}" />
					<DataGridTextColumn Header="氏名" Binding="{Binding G_name}" />
					<DataGridTextColumn Header="性別" Binding="{Binding Sei}" />
					<DataGridTextColumn Header="クラス" Binding="{Binding Cls_name}" />
					<DataGridTextColumn Header="合否" Binding="{Binding Result}" />
				</DataGrid.Columns>
				<ui:DataGrid.ColumnHeaderStyle>
					<Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
						<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
						<Setter Property="MinWidth" Value="50" />
					</Style>
				</ui:DataGrid.ColumnHeaderStyle>
			</ui:DataGrid>
		</ui:Card>
		<StackPanel Grid.Row="3" Height="40" Margin="0,5,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
			<ui:TextBlock HorizontalAlignment="Right" Text="{Binding SearchResultCountText}" VerticalAlignment="Center" />
			<ui:Button Grid.Column="1" VerticalAlignment="Stretch" Margin="5,5,5,5" Icon="{ui:SymbolIcon ArrowLeft24}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="Click">
						<i:InvokeCommandAction Command="{Binding PreviousPageCommand}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
			</ui:Button>
			<ui:TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="{Binding SearchResultPageIndexText}"
					VerticalAlignment="Center" />
			<ui:Button Grid.Column="2" VerticalAlignment="Stretch" Margin="5,5,0,5" Icon="{ui:SymbolIcon ArrowRight24}">
				<i:Interaction.Triggers>
					<i:EventTrigger EventName="Click">
						<i:InvokeCommandAction Command="{Binding NextPageCommand}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
			</ui:Button>
		</StackPanel>
	</Grid>
</Page>
