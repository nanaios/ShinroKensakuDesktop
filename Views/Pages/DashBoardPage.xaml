<Page xmlns:behaviors="clr-namespace:ShinroKensakuDesktop.Views.Behaviors"
      xmlns:controls="clr-namespace:ShinroKensakuDesktop.Views.Controls"
      xmlns:models="clr-namespace:ShinroKensakuDesktop.Models"
      x:Class="ShinroKensakuDesktop.Views.Pages.DashBoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ダッシュボード" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <!-- One bar per registered year. Totals are neutral (blue means 進学), so the selected year is the darkest bar
             and carries its value. -->

        <DataTemplate x:Key="YearBarTemplate" DataType="{x:Type models:YearBar}">
            <Button Style="{StaticResource BarButton}" ToolTip="{Binding Tip}" Padding="2,0"
                    AutomationProperties.Name="{Binding Tip}" CommandParameter="{Binding Year}"
                    Command="{Binding DataContext.OpenYearSearchCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="128" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="Value" Text="{Binding ValueText}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed" />
                        <Border x:Name="Bar" CornerRadius="2,2,0,0" Margin="2,0"
                                Height="{Binding Ratio, Converter={StaticResource RatioToLength}, ConverterParameter=100}"
                                Background="{DynamicResource NeutralBarBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="Year" Grid.Row="1" Text="{Binding Label}" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter TargetName="Value" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Year" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Year" Property="Foreground"
                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowLabel}" Value="False">
                    <Setter TargetName="Year" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="CardLink" TargetType="ui:HyperlinkButton" BasedOn="{StaticResource {x:Type ui:HyperlinkButton}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer behaviors:NavigationViewport.Fit="True" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
        <StackPanel Margin="{StaticResource PagePadding}">
            <DockPanel Style="{StaticResource PageHeader}">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Opens the report folder in the browser; the trailing arrow marks a link that leaves the app. -->
                    <ui:Button x:Name="ReportButton" VerticalAlignment="Center" Margin="0,0,16,0"
                               Icon="{ui:SymbolIcon FolderOpen20}" Click="OpenReports_Click"
                               ToolTip="受験報告書をブラウザで開く" ToolTipOpening="ReportButton_ToolTipOpening"
                               AutomationProperties.Name="受験報告書をブラウザで開く">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="受験報告書" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="Open16" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:Button>
                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource CaptionText}" Margin="0,0,12,0" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise20, FontSize=20}"
                               Style="{StaticResource IconActionButton}"
                               ToolTip="再読み込み" AutomationProperties.Name="再読み込み"
                               Command="{Binding RefreshCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="ダッシュボード" FontTypography="Title" VerticalAlignment="Center" />
                    <ui:TextBlock Text="{Binding YearTitle}" FontTypography="Subtitle" VerticalAlignment="Center"
                                  Margin="16,2,0,0" />
                    <Border Style="{StaticResource Pill}" Margin="8,2,0,0"
                            Visibility="{Binding IsLatestYear, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="最新" />
                    </Border>
                </StackPanel>
            </DockPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}, ConverterParameter=Hide}" />
            <controls:NoticeBar Title="データを取得できませんでした" Message="{Binding ErrorText}"
                                Severity="{Binding HasError, Converter={StaticResource BoolToSeverity}, ConverterParameter=Error}">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="再読み込み" Command="{Binding RefreshCommand}" />
                    <ui:Button Content="接続設定を開く" Command="{Binding OpenSettingsCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </controls:NoticeBar>
            <controls:NoticeBar Title="登録されている受験記録はありません"
                                Severity="{Binding IsEmpty, Converter={StaticResource BoolToSeverity}, ConverterParameter=Info}" />
            <ItemsControl ItemsSource="{Binding SummaryStats}" Style="{StaticResource StatList}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ui:Card Style="{StaticResource SectionCard}" Margin="0" VerticalAlignment="Stretch">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <ui:HyperlinkButton Style="{StaticResource CardLink}" DockPanel.Dock="Right"
                                                Command="{Binding OpenAnalyticsCommand}"
                                                AutomationProperties.Name="受験方法別の推移を見る">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="推移を見る" />
                                    <ui:SymbolIcon Symbol="ChevronRight12" Margin="4,1,0,0" />
                                </StackPanel>
                            </ui:HyperlinkButton>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBlock Text="受験方法別" FontTypography="Subtitle" />
                                <ui:TextBlock Text="{Binding YearTitle, StringFormat=（{0}）}" FontTypography="Body"
                                              VerticalAlignment="Bottom" Margin="4,0,0,3"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Visibility="{Binding YearTitle, Converter={StaticResource TextVisibility}}" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding MethodGroups}" Focusable="False" />
                        <StackPanel Visibility="{Binding IsFirstLoad, Converter={StaticResource BoolVisibility}}">
                            <Border Style="{StaticResource Skeleton}" Width="120" Height="14" Margin="0,4,0,12" />
                            <Border Style="{StaticResource Skeleton}" Width="260" Height="10" Margin="28,0,0,14" />
                            <Border Style="{StaticResource Skeleton}" Width="180" Height="10" Margin="28,0,0,14" />
                            <Border Style="{StaticResource Skeleton}" Width="120" Height="10" Margin="28,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
                <ui:Card Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0" VerticalAlignment="Stretch">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <ui:HyperlinkButton Style="{StaticResource CardLink}" DockPanel.Dock="Right"
                                                Command="{Binding OpenComparisonCommand}"
                                                AutomationProperties.Name="前年度と比べる">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="前年度と比べる" />
                                    <ui:SymbolIcon Symbol="ChevronRight12" Margin="4,1,0,0" />
                                </StackPanel>
                            </ui:HyperlinkButton>
                            <ui:TextBlock Text="年度別の延べ受験数" FontTypography="Subtitle" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding YearBars}" ItemTemplate="{StaticResource YearBarTemplate}"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"
                                    Visibility="{Binding HasData, Converter={StaticResource BoolVisibility}}">
                            <ui:SymbolIcon Symbol="CursorClick20" FontSize="16" Margin="0,0,4,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="棒をクリックで、その年度の明細" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
