<Page xmlns:behaviors="clr-namespace:ShinroKensakuDesktop.Views.Behaviors"
      xmlns:controls="clr-namespace:ShinroKensakuDesktop.Views.Controls"
      x:Class="ShinroKensakuDesktop.Views.Pages.DashBoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ダッシュボード" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate x:Key="SummaryRow">
            <Border BorderThickness="0,0,0,1" Padding="0,8"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:N0} 件}" FontWeight="SemiBold" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer behaviors:NavigationViewport.Fit="True" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
        <StackPanel Margin="36,20,36,32">
            <DockPanel Style="{StaticResource PageHeader}">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise20, FontSize=20}"
                               Style="{StaticResource IconActionButton}"
                               ToolTip="再読み込み" AutomationProperties.Name="再読み込み"
                               Command="{Binding RefreshCommand}" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowTrending20, FontSize=20}"
                               Style="{StaticResource IconActionButton}"
                               ToolTip="進路グラフを開く" AutomationProperties.Name="進路グラフを開く"
                               Appearance="Primary" Command="{Binding OpenAnalyticsCommand}" Margin="8,0,0,0" />
                    <ui:Button Icon="{ui:SymbolIcon Clock20, FontSize=20}" Style="{StaticResource IconActionButton}"
                               ToolTip="年度比較を開く" AutomationProperties.Name="年度比較を開く"
                               Command="{Binding OpenComparisonCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="ダッシュボード" FontTypography="Title" />
                    <controls:InfoTip Margin="8,4,0,0"
                                      Text="登録済みの最新年度を表示します。件数は受験記録単位で、同じ生徒の複数回受験を含みます。年度を選んで見るには進路グラフを開いてください。" />
                </StackPanel>
            </DockPanel>
            <ProgressBar IsIndeterminate="True" Height="3"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8" />
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" DockPanel.Dock="Right"
                           MaxWidth="420" TextAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,0,0" />
                <ui:TextBlock Text="{Binding YearCaption}" FontTypography="BodyStrong" VerticalAlignment="Bottom" />
            </DockPanel>
            <WrapPanel Margin="0,0,0,4">
                <ui:Card Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="受験記録の総数" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="進学" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding StudyText}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="就職" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding WorkText}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </ui:Card>
            </WrapPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ui:Card Style="{StaticResource SectionCard}" Margin="0" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:TextBlock Text="受験方法別" FontTypography="Subtitle" />
                            <controls:InfoTip Margin="8,2,0,0" Text="最新年度の件数を受験方法ごとに表示します。" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Methods}" ItemTemplate="{StaticResource SummaryRow}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:TextBlock Text="年度別" FontTypography="Subtitle" />
                            <controls:InfoTip Margin="8,2,0,0" Text="登録されているすべての年度の件数を表示します。" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Trends}" ItemTemplate="{StaticResource SummaryRow}" />
                    </StackPanel>
                </ui:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
