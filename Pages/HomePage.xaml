<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShinroKensakuDesktop.Pages"
      xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="ShinroKensakuDesktop.Pages.HomePage"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1440"
      Title="HomePage">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="6*"/>
			<RowDefinition Height="2*"/>
			<RowDefinition Height="2*"/>
			<RowDefinition Height="2*"/>
		</Grid.RowDefinitions>
		<wpfui:Button CornerRadius="40,40,40,40" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="200,30,200,0" Height="80" Background="{DynamicResource {x:Static SystemColors.AccentColorLight1BrushKey}}" />
	</Grid>
</Page>
