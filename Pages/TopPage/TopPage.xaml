<Page
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:ShinroKensakuDesktop.Pages.TopPage"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	x:Class="ShinroKensakuDesktop.Pages.TopPage.TopPage"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	mc:Ignorable="d"
	d:DesignHeight="1080"
	d:DesignWidth="1440"
	ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
	ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	Foreground="{DynamicResource TextFillColorPrimaryBrush}"
	Title="TopPage">
	<Page.DataContext>
		<local:ViewModel />
	</Page.DataContext>
	<Page.Resources>
	</Page.Resources>

	<Grid
		Margin="-6,0,0,0">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="1*" />
			<RowDefinition
				Height="200" />
			<RowDefinition
				Height="100" />
			<RowDefinition
				Height="100" />
			<RowDefinition
				Height="1*" />
		</Grid.RowDefinitions>

		<ui:TextBlock
			Grid.Row="1"
			FontSize="64"
			Text="KST-DeCS"
			HorizontalAlignment="Center"
			VerticalAlignment="Bottom"
			Margin="0,0,0,75"
			Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
		<ui:TextBlock
			Grid.Row="1"
			FontSize="24"
			Text="総合科学進路検索システム"
			FontWeight="Light"
			HorizontalAlignment="Center"
			VerticalAlignment="Bottom"
			Margin="0,0,0,25"
			Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
		<Rectangle
			Grid.Row="1"
			Width="180"
			Height="3"
			VerticalAlignment="Bottom"
			Margin="0,0,0,70"
			Fill="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />

		<!-- Search Box -->
		<Grid
			Grid.Row="2"
			Width="500"
			Height="50"
			HorizontalAlignment="Center"
			VerticalAlignment="Center">
			<ui:SymbolIcon
				HorizontalAlignment="Left"
				Symbol="Search12"
				Width="50"
				Height="50"
				Foreground="{DynamicResource TextFillColorSecondaryBrush}"
				FontSize="24"
				Margin="10,0,0,0" />
			<Rectangle
				RadiusX="25"
				RadiusY="25"
				Stroke="{DynamicResource TextFillColorSecondaryBrush}"
				StrokeThickness="0.5" />
			<TextBlock
				Margin="55,0,25,0"
				Foreground="{DynamicResource TextControlPlaceholderForeground}"
				Text="進路先を入力..."
				FontSize="24"
				FontWeight="Light"
				VerticalAlignment="Center"
				Visibility="{Binding IsPlaceHolderVisible}" />
			<TextBox
				Margin="55,0,25,0"
				Style="{x:Null}"
				Background="{x:Null}"
				BorderBrush="{x:Null}"
				FontSize="24"
				BorderThickness="0,0,0,0"
				ClipToBounds="True"
				VerticalAlignment="Center"
				Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
				FontWeight="Light">
				<i:Interaction.Triggers>
					<i:EventTrigger
						EventName="TextChanged">
						<i:InvokeCommandAction
							Command="{Binding TextChangedCommand}"
							PassEventArgsToCommand="True" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
			</TextBox>
		</Grid>

		<ui:Button
			CornerRadius="25,25,25,25"
			Grid.Row="3"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			Height="50"
			Width="500"
			Icon="{ui:SymbolIcon Symbol=Search12}"
			Content="検索開始"
			FontSize="24"
			FontWeight="Light"
			Appearance="Primary"
			Foreground="White" />
	</Grid>
</Page>
